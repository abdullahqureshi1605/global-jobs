"use client";

import { useEffect, useState } from "react";

const CONSENT_COOKIE = "horizon_cookie_consent";

type ConsentValue = "all" | "essential";

function getConsent(): ConsentValue | null {
  if (typeof document === "undefined") return null;

  const match = document.cookie.match(
    new RegExp(`(?:^|; )${CONSENT_COOKIE}=([^;]*)`)
  );

  const value = match?.[1];

  return value === "all" || value === "essential" ? value : null;
}

function saveConsent(value: ConsentValue) {
  document.cookie = `${CONSENT_COOKIE}=${value}; Max-Age=31536000; Path=/; SameSite=Lax; Secure`;
}

export default function CookieConsent() {
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    setVisible(getConsent() === null);
  }, []);

  if (!visible) return null;

  const closeBar = (value: ConsentValue = "essential") => {
    saveConsent(value);
    setVisible(false);
  };

  return (
    <div
      className="z-[100] m-0 w-full border-t border-[#D7A44A] bg-[#0C1122] text-white shadow-[0_-8px_24px_rgba(0,0,0,.35)]" style={{ position: "fixed", left: 0, right: 0, bottom: 0, height: "88px", width: "100%", margin: 0 }}
      role="dialog"
      aria-label="Cookie consent"
      aria-live="polite"
    >
      <div className="mx-auto flex h-full w-full max-w-[1440px] items-center gap-4 px-5 sm:px-8 lg:px-14">
        <div className="flex min-w-0 flex-1 items-center gap-3">
          <span
            className="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[rgba(215,164,74,.14)]"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              className="h-4 w-4 fill-[#E3B968]"
            >
              <path d="M21.6 12.8a1 1 0 0 0-1-.2 2.6 2.6 0 0 1-3.4-2.9 1 1 0 0 0-1-1.2 4.6 4.6 0 0 1-4.4-4.4 1 1 0 0 0-1.2-1A10 10 0 1 0 22 13.7a1 1 0 0 0-.4-.9ZM7.5 15a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm2-6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm6 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z" />
            </svg>
          </span>

          <p className="min-w-0 text-[11px] leading-[1.5] text-[#8F9AB0]">
            <b className="font-semibold text-[#F4F1EA]">
              Your privacy matters.
            </b>{" "}
            Horizon Jobs uses essential cookies to keep the site working, plus
            optional analytics and advertising cookies per our{" "}
            <a
              href="/cookie-policy"
              className="text-[#E3B968] no-underline hover:text-[#F0D29A]"
            >
              Cookie Policy
            </a>{" "}
            and{" "}
            <a
              href="/privacy-policy"
              className="text-[#E3B968] no-underline hover:text-[#F0D29A]"
            >
              Privacy Policy
            </a>
            .
          </p>
        </div>

        <div className="flex shrink-0 items-center gap-2">
          <button
            type="button"
            onClick={() => closeBar("essential")}
            className="h-9 whitespace-nowrap rounded-[7px] border border-[#233052] bg-transparent px-3 text-[11px] font-semibold tracking-[.01em] text-[#F4F1EA] transition hover:bg-[#141B30] focus-visible:outline-2 focus-visible:outline-[#F0D29A] focus-visible:outline-offset-2"
          >
            Essential only
          </button>

          <button
            type="button"
            onClick={() => closeBar("all")}
            className="h-9 whitespace-nowrap rounded-[7px] border border-[#D7A44A] bg-[#D7A44A] px-3.5 text-[11px] font-semibold tracking-[.01em] text-[#080C16] transition hover:bg-[#E3B968] focus-visible:outline-2 focus-visible:outline-[#F0D29A] focus-visible:outline-offset-2"
          >
            Accept all
          </button>

          <button
            type="button"
            onClick={() => closeBar("essential")}
            aria-label="Dismiss"
            className="ml-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#233052] bg-transparent text-[15px] leading-none text-[#8F9AB0] transition hover:border-[#D7A44A] hover:text-[#F4F1EA] focus-visible:outline-2 focus-visible:outline-[#F0D29A] focus-visible:outline-offset-2"
          >
            ×
          </button>
        </div>
      </div>

      <style jsx>{`
        @media (max-width: 860px) {
          div[role="dialog"] {
            height: auto;
          }
        }
      `}</style>
    </div>
  );
}

